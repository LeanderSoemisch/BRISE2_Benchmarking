{
  "Benchmark": {
    "Resources": {
      "Folder": "./results/serialized/"
    },
    "ExperimentSeries": {
      "Name": "test cases",
      "Description": "local testing of benchmark features"
    },
    "Plots": {
      "Improvement": {
        "X": {
          "MetricName": "iterations completed",
          "Label": "iteration",
          "Scale": "linear"
        },
        "Y": {
          "ObjectiveName": "Y1",
          "Normalize": true,
          "Normalization": "min_over_all_experiments",
          "Direction": "minimize",
          "Label": "Normalised objective",
          "Scale": "linear"
        }
      },
      "Time": {
        "X": {
          "MetricName": "iterations completed",
          "Label": "iteration",
          "Scale": "linear"
        },
        "Y": {
          "ObjectiveName": "Time",
          "Normalize": false,
          "Normalization": "",
          "Direction": "",
          "Label": "Computation time (s)",
          "Scale": "log10"
        }
      }
    }
  }
}

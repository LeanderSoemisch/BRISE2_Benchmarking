abstract Axis {
  Label -> string
  Scale -> string
}

abstract ObjectiveAxis: Axis {
  ObjectiveName -> string
  Normalize -> boolean
  Normalization -> string
  Direction -> string
}

abstract MetricAxis: Axis {
  MetricName -> string
}

Benchmark {
  Resources {
    Folder -> string
  }
  ExperimentSeries {
    Name -> string
    Description -> string
  }
  Plots {
    Improvement {
      X: MetricAxis {
        MetricName -> string
        [MetricName = "iterations completed"]
        Label -> string
        [Label = "iteration"]
        Scale -> string
        [Scale = "linear"]
      }
      Y: ObjectiveAxis {
        ObjectiveName -> string
        Normalize -> boolean
        Normalization -> string
        Direction -> string
        Label -> string
        [Label = "Normalised objective"]
        Scale -> string
        [Scale = "linear"]
      }
    }
    Time {
      X: MetricAxis {
        MetricName -> string
        [MetricName = "iterations completed"]
        Label -> string
        [Label = "iteration"]
        Scale -> string
        [Scale = "linear"]
      }
      Y: ObjectiveAxis {
        ObjectiveName -> string
        Normalize -> boolean
        Normalization -> string
        Direction -> string
        Label -> string
        [Label = "Normalised objective"]
        Scale -> string
        [Scale = "linear"]
      }
    }
  }
}

// ----------------------Abstract Benchmark Features-----------------------

abstract Axis {
  Label -> string
  Scale -> string
}

abstract ObjectiveAxis: Axis {
  ObjectiveName -> string
  Normalize -> boolean
  Normalization -> string
  Direction -> string
}

abstract MetricAxis: Axis {
  MetricName -> string
}

// ----------------------Benchmark Features-----------------------

Benchmark {
  Report {
    outputDirectory -> string
  }

  Experiment {
    name -> string
    description -> string
    objectivesToMeasure -> array
  }

  Table ? {
    task -> boolean
    model -> boolean
    sampler -> boolean
    configurationStrategy -> boolean
    stopCondition -> boolean
    experiment -> boolean
    objective -> boolean
    iterations -> boolean
    initialValue -> boolean
    finalBestValue -> boolean
    improvementPercentage -> boolean
    improvementAbsolute -> boolean
    runtime -> boolean
  }

  Plot * {
    xor PlotType {
      ImprovementPlot {
        Type -> predefined
        [Type = 'improvement_plot']
        
        enableGrouping -> boolean

        MetricAxis {
          metricDescription -> string
          label -> string
          scale -> string
          [scale in {"linear", "log10"}]
        }
        ObjectiveAxis {
          objectivesToPlot -> array
          // Each element should be an objective name from Experiment.objectivesToMeasure
          // [all objectivesToPlot in Benchmark.Experiment.objectivesToMeasure]
          normalize -> boolean
          xor NormalizationStrategy {
            MinOverAll {
              Type -> predefined
              [Type = 'min_over_all_experiments']
            }
            MaxOverAll {
              Type -> predefined
              [Type = 'max_over_all_experiments']
            }
          }
          label -> string
          scale -> string
          [scale in {"linear", "log10"}]
        }
      }

      CustomPlot {
        Type -> predefined
        [Type = 'parallel_coordinates_plot']
        
        enableGrouping -> boolean

        MetricAxis {
          metricDescription -> string
          label -> string
          scale -> string
          [scale in {"linear", "log10"}]
        }
        ObjectiveAxis {
          objectivesToPlot -> array
          normalize -> boolean
          xor NormalizationStrategy {
            MinOverAll {
              Type -> predefined
              [Type = 'min_over_all_experiments']
            }
            MaxOverAll {
              Type -> predefined
              [Type = 'max_over_all_experiments']
            }
          }
          label -> string
          scale -> string
          [scale in {"linear", "log10"}]
        }
      }

      BoxPlot {
        Type -> predefined
        [Type = 'box_plot']

        enableGrouping -> boolean

        MetricAxis {
          metricDescription -> string
          label -> string
          scale -> string
          [scale in {"linear", "log10"}]
        }
        ObjectiveAxis {
          objectivesToPlot -> array
          normalize -> boolean
          xor NormalizationStrategy {
            MinOverAll {
              Type -> predefined
              [Type = 'min_over_all_experiments']
            }
            MaxOverAll {
              Type -> predefined
              [Type = 'max_over_all_experiments']
            }
          }
          label -> string
          scale -> string
          [scale in {"linear", "log10"}]
        }
      }
    }
  }

  BaselineConfiguration ? {
    reuseExisting -> boolean

    RandomSearchBaseline ? {
      samplingSize -> integer
    }

    GridSearchBaseline ? {
      gridResolution -> integer
      maxPoints -> integer
    }
  }

  ComparativeMetrics ? {
    showSummaryTable -> boolean

    ComparativeTable ? {
      experiment -> boolean
      baseline -> boolean
      normalizedImprovement -> boolean
      speedupFactor -> boolean
      convergedAtIteration -> boolean
      experimentBest -> boolean
      baselineBest -> boolean
      finalRegret -> boolean
    }

    RegretAnalysis ? {
      knownOptimum -> float
      optimumPerObjective -> object
      regretType -> array
      [regretType in {"iteration", "time"}]
    }

    NormalizedImprovement ? {
      improvementType -> array
      [improvementType in {"objective_value", "time_to_target", iteration_to_target}]
    }

    PerformanceProfile ? {
      tauMax -> float
      tauSteps -> integer
      objectivesToProfile -> array
    }
  }
}
{
  "Benchmark": {
    "Report": {
      "outputDirectory": "./results/reports/"
    },
    "Experiment": {
      "name": "test cases",
      "description": "local testing of benchmark features",
      "objectivesToMeasure": ["Y1", "Y2", "Y3", "Y4", "Y5"]
    },
    "Table": {
      "columns": [
        "iterations",
        "initial_value",
        "final_best_value",
        "improvement",
        "absolute_improvement",
        "runtime"
      ]
    },
    "Plots": {
      "plot1": {
        "x": {
          "metricDescription": "iterations completed",
          "label": "iteration",
          "scale": "linear"
        },
        "y": {
          "objectivesToPlot": ["Y1","Y2","Y3","Y4","Y5"],
          "normalize": true,
          "normalization": "min_over_all_experiments",
          "label": "Normalised objective",
          "scale": "linear"
        }
      },
      "plot2": {
        "enabled": true,
        "x": {
          "metricDescription": "iterations completed",
          "label": "iteration",
          "scale": "linear"
        },
        "y": {
          "objectivesToPlot": ["Y1","Y2","Y3","Y4","Y5"],
          "normalize": false,
          "normalization": "max_over_all_experiments",
          "label": "Computation time (s)",
          "scale": "log10"
        }
      }
    }
  }
}


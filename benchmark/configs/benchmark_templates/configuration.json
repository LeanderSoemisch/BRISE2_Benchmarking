      "outputDirectory": "./results/reports/generic_pc_sparse_and_hh_pc/"
    },
    "Experiment": {
      "name": "Generic PC: Sparse PC and HH-PC",
      "description": "Analysis of sparse_pc_and_hh_pc experiments. Each TSP instance is a separate report tab. Within each tab, experiments are grouped by MH type and tuning variant (S-TPE, S-BRR, H-TPE, H-BRR).",
      "objectivesToMeasure": ["kroA100.tsp", "pla7397.tsp", "pr439.tsp", "rat783.tsp"]
    },
    "KnownOptima": {
      "kroA100.tsp":  21282,

@startuml Benchmark_Sequence_Diagram
!theme plain
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam BoxPadding 10
skinparam ParticipantPadding 20

actor User #lightgreen
participant "Orchestrator" as Orchestrator #lightyellow
participant "Benchmark\nRunner" as BenchmarkRunner #lightblue
participant "Main Node" as MainNode #lavender
participant "RabbitMQ" as RabbitMQ #wheat
participant "Worker" as Worker #lightcyan
participant "Analyzer" as Analyzer #pink

== 1. Initialization ==
User -> Orchestrator: **Start Benchmark**\n//./init.sh up benchmark//
activate Orchestrator
Orchestrator -> BenchmarkRunner: run_benchmark()
activate BenchmarkRunner

@enduml
